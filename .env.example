NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only placeholders. Never expose service-role keys to client components.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-secure-server-runtime
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-only-in-secure-server-runtime
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

MIDTRANS_SERVER_KEY=replace-only-in-secure-server-runtime
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
XENDIT_SECRET_KEY=replace-only-in-secure-server-runtime

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=replace-only-in-secure-server-runtime

EMAIL_PROVIDER_KEY=replace-only-in-secure-server-runtime
WHATSAPP_PROVIDER_KEY=replace-only-in-secure-server-runtime
STREAM_PROVIDER_KEY=replace-only-in-secure-server-runtime